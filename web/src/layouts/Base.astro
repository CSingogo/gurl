---
import { Font } from "astro:assets";
import { site } from "@/lib/site";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Hide the footer on app-like pages. */
  bare?: boolean;
}
const { title, description = site.description, bare = false } = Astro.props;
const fullTitle = title ? `${title} · gurl` : `gurl: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en" data-os="macos">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e0e10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gurl" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <Font cssVariable="--font-geist-sans" />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-wordmark" />
    <!-- Self-hosted Umami (stats.somosingogo.dev). Production only; data-domains ignores localhost. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://stats.somosingogo.dev/script.js"
          data-website-id="6036a524-1d49-4334-9a2f-6952dffec783"
          data-domains="gurl.somosingogo.dev"
        />
      )
    }
    <!-- Pick the OS before first paint: saved choice, else guess from the browser. -->
    <script is:inline>
      (function () {
        var os = "macos";
        try {
          var saved = localStorage.getItem("gurl-os");
          if (saved) os = saved;
          else {
            var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.userAgent || "";
            if (/win/i.test(p)) os = "windows";
            else if (/linux|x11/i.test(p) && !/android/i.test(navigator.userAgent)) os = "linux";
          }
        } catch (e) {}
        document.documentElement.dataset.os = os;
      })();
    </script>
  </head>
  <body class="flex flex-col">
    <Header />
    <main class="flex-1"><slot /></main>
    {!bare && <Footer />}
    <!-- Shared OS state: every picker and every [data-os-only] block follows html[data-os]. -->
    <script>
      const groups: Record<string, string[]> = {
        macos: ["macos"],
        ubuntu: ["ubuntu", "linux"],
        arch: ["arch", "linux"],
        linux: ["linux"],
        windows: ["windows"],
      };
      function apply() {
        const os = document.documentElement.dataset.os ?? "macos";
        const show = groups[os] ?? [os];
        document.querySelectorAll<HTMLElement>("[data-os-only]").forEach((el) => {
          const wants = (el.dataset.osOnly ?? "").split(" ");
          el.hidden = !wants.some((w) => show.includes(w));
        });
        document.querySelectorAll<HTMLSelectElement>("select[data-os-picker]").forEach((s) => (s.value = os));
        document.querySelectorAll<HTMLElement>("[data-os-tab]").forEach((t) => {
          t.setAttribute("aria-selected", String(t.dataset.osTab === os));
        });
      }
      document.addEventListener("click", (e) => {
        const tab = (e.target as HTMLElement).closest<HTMLElement>("[data-os-tab]");
        if (tab?.dataset.osTab) setOs(tab.dataset.osTab);
      });
      document.addEventListener("change", (e) => {
        const t = e.target as HTMLElement;
        if (t instanceof HTMLSelectElement && t.hasAttribute("data-os-picker")) setOs(t.value);
      });
      function setOs(os: string) {
        document.documentElement.dataset.os = os;
        try {
          localStorage.setItem("gurl-os", os);
        } catch {}
        apply();
      }
      apply();

      // Copy buttons: <button data-copy="text">. The icon swaps to a tick for a moment.
      document.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-copy]");
        if (!btn) return;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          btn.setAttribute("data-copied", "");
          setTimeout(() => btn.removeAttribute("data-copied"), 1400);
        } catch {}
      });

      // Every code block in the docs gets a copy button in its top-right corner.
      const iconHtml = `<svg viewBox="0 0 24 24" class="icon-copy size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg><svg viewBox="0 0 24 24" class="icon-done size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 10 17.5 19 7"/></svg>`;
      document.querySelectorAll<HTMLPreElement>(".prose-docs pre").forEach((pre) => {
        const wrap = document.createElement("div");
        wrap.className = "code-block";
        pre.replaceWith(wrap);
        wrap.append(pre);
        const btn = document.createElement("button");
        btn.className = "copy-btn";
        btn.setAttribute("aria-label", "Copy code");
        btn.title = "Copy";
        btn.dataset.copy = (pre.textContent ?? "").replace(/\n$/, "");
        btn.innerHTML = iconHtml;
        wrap.append(btn);
      });
    </script>
    <noscript><style>[data-fade-content]{visibility:visible!important}</style></noscript>
  </body>
</html>
