---
import { site } from "@/lib/site";
const links = [
  { href: "/docs/getting-started", label: "Docs" },
  { href: "/docs/install", label: "Install" },
  { href: "/docs/flags", label: "Flags" },
  { href: "/docs/test-server", label: "Test server" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-baseline gap-[3px] text-xl font-semibold tracking-tight">
      gurl<span class="inline-block size-2 rounded-full bg-brand"></span>
    </a>
    <nav class="hidden items-center gap-1 rounded-full border border-line bg-surface px-2 py-1.5 text-sm md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "rounded-full px-3.5 py-1 transition-colors hover:text-fg",
              path.startsWith(l.href) ? "bg-surface-2 text-fg" : "text-muted",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2 text-sm">
      <a
        href={site.sponsor}
        target="_blank"
        rel="noopener"
        class="hidden rounded-lg border border-line px-3 py-1.5 text-muted transition-colors hover:text-fg sm:block"
      >
        Sponsor
      </a>
      <a
        href={site.repo}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 rounded-lg bg-brand px-3 py-1.5 font-medium text-brand-fg transition-opacity hover:opacity-90"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path></svg
        >
        GitHub
      </a>
    </div>
  </div>
</header>
