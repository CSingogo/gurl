---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import OsPicker from "@/components/OsPicker.astro";
import { site } from "@/lib/site";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Sidebar: group by section, keep sections in the order their first page appears.
const all = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const sections = new Map<string, typeof all>();
for (const d of all) sections.set(d.data.section, [...(sections.get(d.data.section) ?? []), d]);
const searchIndex = all.map((d) => ({ title: d.data.title, description: d.data.description, href: `/docs/${d.id}` }));
const here = `/docs/${entry.id}`;
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto grid max-w-7xl md:grid-cols-[16rem_1fr]">
    <aside class="hidden border-r border-line md:block">
      <nav class="sticky top-16 max-h-[calc(100dvh-4rem)] space-y-7 overflow-y-auto p-5 text-sm">
        {
          [...sections.entries()].map(([name, pages]) => (
            <div>
              <p class="mb-2 px-3 text-[11px] uppercase tracking-[0.18em] text-muted">{name}</p>
              <ul class="space-y-0.5">
                {pages.map((p) => (
                  <li>
                    <a
                      href={`/docs/${p.id}`}
                      aria-current={here === `/docs/${p.id}` ? "page" : undefined}
                      class="block rounded-lg px-3 py-2 text-muted transition-colors hover:text-fg aria-[current=page]:bg-surface-2 aria-[current=page]:text-fg"
                    >
                      {p.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <p class="mb-2 px-3 text-[11px] uppercase tracking-[0.18em] text-muted">Project</p>
          <ul class="space-y-0.5">
            <li><a class="block rounded-lg px-3 py-2 text-muted hover:text-fg" href={site.repo}>GitHub ↗</a></li>
            <li><a class="block rounded-lg px-3 py-2 text-muted hover:text-fg" href={site.releases}>Releases ↗</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <div class="min-w-0 px-4 py-8 sm:px-8 lg:px-12">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
        <button
          id="search-open"
          class="flex w-full max-w-sm items-center justify-between gap-3 rounded-xl border border-line bg-surface px-3.5 py-2 text-sm text-muted transition-colors hover:text-fg"
        >
          <span>Search documentation…</span>
          <kbd class="rounded-md bg-surface-2 px-1.5 py-0.5 font-mono text-xs">⌘K</kbd>
        </button>
        <OsPicker />
      </div>
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-muted">Documentation<span class="text-brand">_</span></p>
      <article class="prose-docs">
        <h1>{entry.data.title}</h1>
        <p class="!mt-0 text-lg text-muted">{entry.data.description}</p>
        <Content />
      </article>
    </div>
  </div>

  <dialog id="search" class="m-auto w-[min(36rem,92vw)] rounded-2xl border border-line bg-surface p-0 text-fg backdrop:bg-black/60 backdrop:backdrop-blur-sm">
    <input
      id="search-input"
      type="search"
      placeholder="Search documentation…"
      autocomplete="off"
      class="w-full border-b border-line bg-transparent px-5 py-4 text-base outline-none"
    />
    <ul id="search-results" class="max-h-80 overflow-y-auto p-2 text-sm"></ul>
  </dialog>
  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />
  <script>
    const dialog = document.getElementById("search") as HTMLDialogElement;
    const input = document.getElementById("search-input") as HTMLInputElement;
    const list = document.getElementById("search-results") as HTMLUListElement;
    const pages: { title: string; description: string; href: string }[] = JSON.parse(
      document.getElementById("search-data")!.textContent ?? "[]",
    );
    function render() {
      const q = input.value.trim().toLowerCase();
      const hits = pages.filter((p) => !q || `${p.title} ${p.description}`.toLowerCase().includes(q));
      list.replaceChildren(
        ...hits.map((p) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = p.href;
          a.className = "block rounded-lg px-3 py-2 hover:bg-surface-2";
          const t = document.createElement("div");
          t.textContent = p.title;
          const d = document.createElement("div");
          d.className = "text-xs text-muted";
          d.textContent = p.description;
          a.append(t, d);
          li.append(a);
          return li;
        }),
      );
    }
    function open() {
      input.value = "";
      render();
      dialog.showModal();
      input.focus();
    }
    document.getElementById("search-open")?.addEventListener("click", open);
    addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        open();
      }
    });
    input.addEventListener("input", render);
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  </script>
</Base>
