---
import Base from "@/layouts/Base.astro";
import InstallTerminal from "@/components/InstallTerminal.astro";
import WindowDemo from "@/components/WindowDemo.astro";
import { site } from "@/lib/site";

const features = [
  {
    title: "curl's flags, unchanged",
    body: "-X, -H, -d, --json, -L, -o, -w and friends behave the way you already know. Exit codes match too, so your scripts keep working.",
    code: "gurl -sSL -H 'Accept: application/json' example.com",
  },
  {
    title: "Pretty in a terminal, exact in a pipe",
    body: "On a TTY you get colour and indented JSON. Pipe it, redirect it or pass --raw and you get the exact bytes the server sent.",
    code: "gurl api.example.com/users | jq .",
  },
  {
    title: "One static binary",
    body: "Written in Go with the standard library only. Linux, macOS and Windows, on amd64 and arm64, with no runtime to install.",
    code: "gurl --version",
  },
  {
    title: "WebSocket, from scratch",
    body: "RFC 6455 implemented by hand: handshake, framing, masking, ping and pong. Coming in v0.4.",
    code: "gurl wss://echo.example.com",
    soon: true,
  },
  {
    title: "A test server you can hit",
    body: "This domain doubles as an httpbin-style echo server: /get, /post, /status/418, /delay/2, /redirect/3 and more.",
    code: "gurl gurl.somosingogo.dev/headers",
  },
  {
    title: "Built to be read",
    body: "Small commits and comments that explain the Go and Linux ideas behind each change. It's a learning project in the open.",
    code: "git log --oneline",
  },
];
---

<Base>
  <section class="hero-glow border-b border-line">
    <div class="mx-auto flex max-w-5xl flex-col items-center px-4 pb-16 pt-16 text-center sm:px-6 sm:pt-24">
      <a
        href={site.repo + "/releases"}
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3.5 py-1.5 text-sm text-muted transition-colors hover:text-fg"
      >
        <span class="font-medium text-brand">New</span>
        gurl v0.1 is on its way
        <span aria-hidden="true">→</span>
      </a>
      <h1 class="text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">
        <span class="gradient-text">Gurl is curl,</span><br />
        but written in Go<span class="cursor"></span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
        A curl-compatible HTTP and WebSocket client with readable output in your terminal and
        byte-exact output in your pipes. One binary, no dependencies.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/docs/install" class="rounded-lg bg-brand px-5 py-3 font-medium text-brand-fg transition-opacity hover:opacity-90">
          Install gurl
        </a>
        <a href="/docs/getting-started" class="rounded-lg border border-line px-5 py-3 font-medium transition-colors hover:bg-surface">
          View docs
        </a>
      </div>
      <div class="mt-14 w-full">
        <InstallTerminal />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <WindowDemo />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">Why gurl<span class="text-brand">_</span></p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      Everything you reach for curl for, and a bit nicer to look at.
    </h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="flex flex-col gap-4 bg-bg p-6">
            <h3 class="flex items-center gap-2 text-lg font-medium">
              {f.title}
              {f.soon && (
                <span class="rounded-full border border-line px-2 py-0.5 text-[10px] uppercase tracking-wider text-muted">
                  soon
                </span>
              )}
            </h3>
            <p class="text-sm leading-relaxed text-muted">{f.body}</p>
            <code class="mt-auto overflow-x-auto whitespace-nowrap rounded-lg border border-line bg-surface px-3 py-2 font-mono text-xs text-muted">
              <span class="text-brand">$</span> {f.code}
            </code>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Free and open source<span class="cursor"></span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-muted">
        gurl is MIT licensed and always will be. A star, a bug report or a coffee all help.
      </p>
      <div class="mx-auto mt-10 grid max-w-2xl gap-3 sm:grid-cols-3">
        <a href={site.repo} class="rounded-xl border border-line bg-surface px-4 py-4 transition-colors hover:bg-surface-2">★ Star on GitHub</a>
        <a href={site.repo + "/issues"} class="rounded-xl border border-line bg-surface px-4 py-4 transition-colors hover:bg-surface-2">Report an issue</a>
        <a href={site.sponsor} class="rounded-xl border border-brand/40 bg-brand/10 px-4 py-4 text-brand transition-colors hover:bg-brand/20">♥ Become a sponsor</a>
      </div>
    </div>
  </section>
</Base>
