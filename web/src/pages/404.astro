---
import Base from "@/layouts/Base.astro";
---

<Base title="Not found">
  <section class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="font-mono text-sm text-muted">HTTP/2 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Nothing here<span class="cursor"></span></h1>
    <p class="mt-4 text-muted">That page doesn't exist. Try the docs.</p>
    <a href="/docs/getting-started" class="mt-8 inline-block rounded-lg bg-brand px-5 py-3 font-medium text-brand-fg">Open the docs</a>
  </section>
</Base>
