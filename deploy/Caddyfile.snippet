# Append to /etc/caddy/Caddyfile on the VPS (and to somo-dev/deploy/Caddyfile,
# which is the source of truth for that file).
#
# Cloudflare's free certificate covers one subdomain level (*.somosingogo.dev),
# which is why this is gurl.somosingogo.dev and not something.gurl.somosingogo.dev.
#
# Two things live on this host: the Astro site (static files, built from web/ and
# rsynced to /var/www/gurl/site) and the Go server (test endpoints + install.sh).
# Caddy decides by path; the list below must match the routes in internal/server.

gurl.somosingogo.dev {
	encode zstd gzip
	root * /var/www/gurl/site

	@api path /get /post /put /patch /delete /anything /anything/* /headers /ip /user-agent /status/* /delay/* /bytes/* /redirect/* /basic-auth/* /json /gzip /install.sh /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8088
	}

	# Static apt repository (added once the signing key exists).
	handle /apt/* {
		root * /var/www/gurl
		file_server
	}

	# Everything else is the static Astro site.
	handle {
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
